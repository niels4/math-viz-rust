# marker-off-down (h8-plane): center=-12,0 with p=-12 puts P at (-12, -12)
# past the bottom edge: the 130-wide label with the down arrow.
# Behaviour: url line center=-12,0&p=-12; no q line.
size 1440 900
density 2
scheme dark
mode dark
theme arctic-ice
query center=-12,0&p=-12
wait 2000
shot marker-off-down
